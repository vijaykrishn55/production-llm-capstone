# API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
MAX_CHUNK_CHARS=1200
CHUNK_OVERLAP_CHARS=180
DEFAULT_TOP_K=5
MAX_TOP_K=12
RRF_K=60
MAX_AGENT_STEPS=5
RATE_LIMIT_PER_MINUTE=120
SQLITE_PATH=data/capstone.db
CORPUS_PATH=data/corpus.json

# Embeddings / vector database
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=capstone_chunks

# vLLM OpenAI-compatible endpoint
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_TIMEOUT_SECONDS=90
MAX_NEW_TOKENS=700

# Training (GPU environment only)
BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
TRAIN_DATA=data/instruction_dataset.jsonl
ADAPTER_OUTPUT=artifacts/qlora-adapter
MERGED_OUTPUT=artifacts/merged-model
AWQ_OUTPUT=models/merged-awq
HF_TOKEN=

# Evaluation: uses the vLLM endpoint by default; no OpenAI key needed
EVAL_BASE_URL=http://localhost:8001/v1
EVAL_MODEL=Qwen/Qwen2.5-3B-Instruct
EVAL_API_KEY=EMPTY
